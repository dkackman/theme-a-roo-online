# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control!
# ============================================

# ============================================
# Database Configuration (Local PostgreSQL)
# ============================================
# Your local PostgreSQL connection details
# Format: postgresql://username:password@host:port/database

# Supabase-compatible connection (for local Postgres)
NEXT_PUBLIC_SUPABASE_URL=http://192.168.1.75:3000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Direct PostgreSQL connection (for server-side operations)
# CHANGE THIS: Replace with your actual credentials
# Note: Special characters in password must be URL-encoded
# Example: & -> %26, @ -> %40, # -> %23, ^ -> %5E
DATABASE_URL=postgresql://username:password@host:port/database

# ============================================
# Authentication (Supabase Auth replacement)
# ============================================
# For local development, you'll need to either:
# 1. Run Supabase local stack (includes Auth)
# 2. Implement custom auth using JWT
# 3. Keep using production Supabase Auth

# JWT Secret for local auth (generate a random string)
JWT_SECRET=your-jwt-secret-here-change-this-in-production

# ============================================
# IPFS / Pinata Configuration
# ============================================
# Option 1: Keep using production Pinata (simplest)
PINATA_JWT=your-pinata-jwt-token
PINATA_GATEWAY_URL=https://your-gateway.mypinata.cloud

# Option 2: Local IPFS node (if you set one up)
# IPFS_API_URL=http://localhost:5001
# IPFS_GATEWAY_URL=http://localhost:8080

# ============================================
# Application Settings
# ============================================
NODE_ENV=development
PORT=3000

# Disable telemetry for local development
NEXT_TELEMETRY_DISABLED=1

# ============================================
# Optional: Vercel Analytics (leave empty for local)
# ============================================
# NEXT_PUBLIC_VERCEL_URL=
# VERCEL_URL=
