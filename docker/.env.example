# ============================================
# Supabase Docker Stack Configuration
# ============================================
# Copy this file to .env and fill in your values
# Deploy to your Docker server at 192.168.1.75
# ============================================

# ============================================
# PostgreSQL Connection
# ============================================
# CHANGE THIS: Use your actual PostgreSQL password
POSTGRES_PASSWORD=your-secure-postgres-password-here
# URL-encoded version for connection strings
# If your password has special characters, URL-encode them:
# & -> %26, @ -> %40, # -> %23, ^ -> %5E
POSTGRES_PASSWORD_ENCODED=your-url-encoded-password-here

# ============================================
# JWT Configuration
# ============================================
# Generate a secure random string (at least 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# ============================================
# API Keys
# ============================================
# IMPORTANT: These MUST be JWT tokens signed with your JWT_SECRET
# Generate them using the script in scripts/generate-api-keys.js
# Or manually using: https://jwt.io with your JWT_SECRET
#
# Format: JWT with payload:
#   ANON_KEY: {"role": "anon", "iss": "supabase", "iat": <timestamp>, "exp": <far-future>}
#   SERVICE_ROLE_KEY: {"role": "service_role", "iss": "supabase", "iat": <timestamp>, "exp": <far-future>}

# ANON_KEY: Used by clients (public)
ANON_KEY=your-generated-anon-key-jwt-token-here

# SERVICE_ROLE_KEY: Used by services (private - admin access)
SERVICE_ROLE_KEY=your-generated-service-role-key-jwt-token-here

# ============================================
# API URLs
# ============================================
# External URL that clients will use to connect
API_EXTERNAL_URL=http://192.168.1.75:8000

# Your frontend URL
SITE_URL=http://localhost:3000

# Additional allowed redirect URLs (comma-separated)
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**

# ============================================
# Auth Settings
# ============================================
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

# ============================================
# SMTP Settings (Optional - for email)
# ============================================
# Leave empty to disable email functionality
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@example.com

# ============================================
# Dashboard Settings
# ============================================
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated
